# =============================================================================
# Ellipsis Venture: AI Deep Tech Founder Sourcing Engine - Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://sourcing_user:your_password@localhost:5432/sourcing_engine

# -----------------------------------------------------------------------------
# Core Pipeline Settings
# -----------------------------------------------------------------------------
LOOKBACK_DAYS=7                    # How many days back to search
MIN_SCORE_THRESHOLD=5.0            # Minimum score to qualify a lead
HOT_LEAD_THRESHOLD=7.5             # Score threshold for HOT leads
MONTHLY_BUDGET_USD=300             # Monthly budget for paid services
COST_ALERT_THRESHOLD=0.8           # Alert when 80% of budget used
OUTPUT_DIR=./output                # Where to save output files

# -----------------------------------------------------------------------------
# Data Sources (Free - No API Keys Required)
# -----------------------------------------------------------------------------

# ArXiv Papers (Always free)
ARXIV_ENABLED=true

# EU Grants - CORDIS (Always free)
EU_GRANTS_ENABLED=true

# Conferences (Web scraping - always free)
# Covers: NeurIPS, ICML, ICLR, CVPR, ECCV, EMNLP, ACL, ECAI
CONFERENCES_ENABLED=true

# University Spin-offs (Web scraping - always free)
# Covers: 40 European universities
UNIVERSITY_SPINOFFS_ENABLED=true

# Accelerators (Web scraping - always free)
# Covers: 22 European accelerators
ACCELERATORS_ENABLED=true

# Hackathons - Devpost, MLH (Web scraping - always free)
HACKATHONS_ENABLED=true

# Technical Blogs - Medium, Substack (Web scraping - always free)
BLOGS_ENABLED=true

# -----------------------------------------------------------------------------
# Data Sources (Require Free Registration)
# -----------------------------------------------------------------------------

# GitHub Trending
# Get token at: https://github.com/settings/tokens
# Free tier: 5,000 requests/hour
GITHUB_ENABLED=true
GITHUB_TOKEN=ghp_your_github_token_here

# -----------------------------------------------------------------------------
# Data Sources (Paid - Optional)
# -----------------------------------------------------------------------------

# Twitter/X Academic Monitoring
# Get at: https://developer.twitter.com/
# Cost: $100/month (Essential plan, 10K tweets/month)
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=

# European Patent Office (EPO)
# Register at: https://developers.epo.org/
# Cost: Free for non-commercial use
PATENTS_ENABLED=false
EPO_API_KEY=
EPO_API_SECRET=

# -----------------------------------------------------------------------------
# Enrichment Services (Paid)
# -----------------------------------------------------------------------------

# LinkedIn Profile Enrichment (Proxycurl)
# Sign up at: https://nubela.co/proxycurl/
# Plans: $99/month (300 requests/day) to $299/month (1000/day)
# Cost per request: ~$0.01-0.03 per profile
# Smart enrichment: Only enriches leads with score >= 5.0
LINKEDIN_ENABLED=false
PROXYCURL_API_KEY=

# Email Finding (Hunter.io)
# Sign up at: https://hunter.io/
# Plans: $49/month (1,000 searches) to $399/month (20,000 searches)
# Cost per search: ~$0.05
# Smart enrichment: Only searches for leads with score >= 7.5
EMAIL_FINDING_ENABLED=false
HUNTER_IO_API_KEY=

# -----------------------------------------------------------------------------
# CRM Integration (Optional)
# -----------------------------------------------------------------------------

# Airtable
# Sign up at: https://airtable.com/
# Free tier: 1,200 records
# Plus: $20/user/month (50,000 records)
AIRTABLE_ENABLED=false
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# -----------------------------------------------------------------------------
# Monitoring & Alerts (Free)
# -----------------------------------------------------------------------------

# Slack Webhooks
# Create at: https://api.slack.com/messaging/webhooks
# Cost: Free
SLACK_WEBHOOK_URL=
ENABLE_SLACK_ALERTS=false

# -----------------------------------------------------------------------------
# Advanced Configuration (Optional - uses defaults if not set)
# -----------------------------------------------------------------------------

# University Lists (JSON arrays)
# TIER_1_UNIVERSITIES=["ETH Zurich","EPFL","Oxford","Cambridge"]
# TIER_2_UNIVERSITIES=["TUM","KTH","TU Delft","UCL"]

# Accelerator Lists (JSON arrays)
# TIER_1_ACCELERATORS=["Entrepreneur First","Techstars","Antler"]
# TIER_2_ACCELERATORS=["Seedcamp","Rockstart","Startup Wise Guys"]

# AI Conferences to Monitor (JSON array)
# AI_CONFERENCES=["NeurIPS","ICML","ICLR","CVPR"]

# -----------------------------------------------------------------------------
# Budget Tiers Guide
# -----------------------------------------------------------------------------
#
# FREE ($0/month - 8/10 sources):
#   - ArXiv, EU Grants, GitHub, Conferences, Universities,
#     Accelerators, Hackathons, Blogs
#   - ~300-400 leads/month, no enrichment
#   - Perfect for testing and validation
#
# STARTER ($150/month):
#   - All free sources + LinkedIn (basic) + Email finding
#   - ~200 qualified + enriched leads/month
#   - 50 HOT leads with contact info
#
# PROFESSIONAL ($300/month):
#   - All sources + full LinkedIn + Email + Twitter
#   - ~250 qualified + enriched leads/month
#   - 75 HOT leads with full profiles
#
# -----------------------------------------------------------------------------
