# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sourcing_engine

# API Keys
GITHUB_TOKEN=your_github_token_here
PROXYCURL_API_KEY=your_proxycurl_api_key_here
HUNTER_IO_API_KEY=your_hunter_io_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_NAME=Leads

# Optional: Crunchbase/Tracxn for accelerator data
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# Monitoring & Alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SENTRY_DSN=your_sentry_dsn_here

# Cost Management
MONTHLY_BUDGET=150.00
ENABLE_COST_ALERTS=true

# Pipeline Configuration
MIN_SCORE_THRESHOLD=6.0
DAYS_BACK_ARXIV=7
ENABLE_SMART_ENRICHMENT=true
